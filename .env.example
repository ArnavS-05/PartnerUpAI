# Server-only configuration. Never use a VITE_ prefix for secrets.
DATABASE_URL=file:./dev.db
# Generate a random 32+ character secret before deploying.
SESSION_SECRET=
AI_PROVIDER=muse
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
AI_TIMEOUT_MS=5000
MUTUAL_MONTHLY_LIMIT=5
MUTUAL_REQUEST_DAYS=30
DEMO_ENABLED=true
PORT=8787
# With no Muse key, Scout transparently uses Offline matching.

# Restrict a disposable public host to fictional accounts. Keep false locally.
DEMO_ONLY=false
